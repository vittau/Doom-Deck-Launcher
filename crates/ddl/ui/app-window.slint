    in property <string> fit-label;
    in property <float> fit-width;
    in property <float> fit-height;
    in property <float> fit-size;
    in property <float> fit-smaller;
    in property <bool> fit-multiline: true;
    in property <bool> fit-display: true;
    in property <bool> fit-strong: false;
