        label: root.heading; base-size: Tokens.page; smaller-size: Tokens.section; multiline: false;
    }
    Text { x: 40px; y: 176px; width: root.art-band ? 784px : parent.width - 80px; height: 32px; text: root.status; color: Tokens.muted; overflow: elide; }
    Rectangle {
        x: 20px; y: root.discover-screen ? 230px : 210px; width: parent.width - 40px; height: parent.height - (root.discover-screen ? 298px : 278px);
        clip: true;
        main-plane := ScrollPlane {
        width: parent.width; height: parent.height;
        extent-width: root.content-width; extent-height: root.content-height;
        offset <=> root.scroll-offset;
        for item in root.nodes: Node { x: (item.x + 8) * 1px; y: (item.y + 8) * 1px; visible: !root.setup-screen || item.x < 700; item: item; install-primary: root.install-pulse && item.id == 1; pulse: root.install-pulse && item.id == 1; focused: root.focused == item.id && !root.sheet-open; activate(id) => { root.clicked(id); } }
    }
    }
    Rectangle {
        visible: root.setup-screen;
        x: 728px; y: 218px; width: parent.width - 756px; height: parent.height - 294px;
        clip: true;
        setup-plane := ScrollPlane {
            width: parent.width; height: parent.height;
            extent-height: root.setup-content-height; extent-width: root.setup-content-width;
            offset <=> root.setup-scroll-offset;
            for item in root.nodes: Node { x: (item.x - 700) * 1px; visible: item.x >= 700; item: item; install-primary: root.install-pulse && item.id == 1; pulse: root.install-pulse && item.id == 1; focused: root.focused == item.id && !root.sheet-open; activate(id) => { root.clicked(id); } }
        }
    }
    toast-banner := Rectangle {
        visible: root.displayed-toast != "";
        opacity: root.toast != "" ? 1 : 0;
        animate opacity { duration: 300ms; }
        x: 40px; y: 172px; width: parent.width - 80px; height: 64px;
        background: Tokens.raised; border-radius: 8px; border-width: 2px; border-color: Tokens.line;
        Text { x: 16px; width: parent.width - 32px; text: root.displayed-toast; color: Tokens.text; font-size: Tokens.metadata; vertical-alignment: center; wrap: word-wrap; }
    }
    Rectangle {
        visible: root.sheet-open;
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: #120C0DE0;
        Rectangle {
            x: (parent.width - 720px) / 2; y: (parent.height - self.height) / 2; width: 720px; height: min(root.sheet-height * 1px, parent.height - 80px);
            background: Tokens.raised; border-width: 1px; border-color: Tokens.line; border-radius: 12px;
            Frame { width: parent.width; height: parent.height; }
            Rectangle { width: parent.width; height: parent.height; clip: true;
            sheet-plane := ScrollPlane {
            width: parent.width; height: parent.height;
            extent-height: root.sheet-height; extent-width: 720;
            offset <=> root.sheet-scroll-offset;
            FittedText { x: 32px; y: 32px; width: parent.width - 64px; height: root.sheet-height > 400 ? 64px : root.sheet-height > 300 ? 164px : 96px;
                label: root.sheet-title; base-size: Tokens.section; smaller-size: Tokens.body;
                title-slot: root.sheet-height > 400;
            }
            if root.profile-name-open: Rectangle {
                x: 32px; y: 140px; width: 656px; height: 64px;
                background: #170f0d; border-width: 2px;
                border-color: name-input.has-focus ? #efb44f : #72503a;
            }
            name-input := TextInput {
                visible: root.profile-name-open;
                x: 48px; y: 152px; width: 624px; height: 40px;
                color: #ead8b7; font-family: "Barlow"; font-size: 24px;
                text <=> root.profile-name;
                single-line: true;
                changed has-focus => { if self.has-focus { root.profile-name-focused(); } }
                edited => { root.profile-name-error = ""; }
                accepted => { root.clicked(917); }
                key-pressed(event) => {
                    if event.text == Key.Escape { root.action(5); return accept; }
                    if event.text == Key.DownArrow || event.text == Key.Tab { root.action(1); return accept; }
                    return reject;
                }
            }
            if root.profile-name-open: Text {
                x: 32px; y: 224px; width: 656px; height: 40px;
                text: root.profile-name-error; color: #efb44f; font-size: 20px;
            }
            if root.profile-name-open: Text {
                x: 32px; y: 282px; width: 656px; height: 36px;
                text: @tr("Keyboard unavailable? Press Steam + X."); color: #ead8b7; font-size: 20px;
            }
            Rectangle {
                visible: root.sheet-error-text != "";
                x: 32px; y: 96px; width: 656px; height: 180px; clip: true;
            error-plane := ScrollPlane {
                width: parent.width; height: parent.height;
                extent-height: error-text.preferred-height / 1px; extent-width: 656;
                error-text := Text {
                    width: parent.width; text: root.sheet-error-text; font-size: 22px;
                    color: Tokens.text; wrap: word-wrap;
                }
            }
            }
            for item in root.sheet-nodes: Node { visible: item.id != 918; item: item; focused: root.focused == item.id; activate(id) => { root.clicked(id); } }
            }
            }
        }
    }
    Rectangle {
        x: 0px; width: parent.width; y: parent.height - 64px; height: 64px; background: Tokens.deep;
        HorizontalLayout {
            visible: !root.input-locked;
            y: 18px; width: parent.width; height: 28px; alignment: start;
            padding-left: 40px; padding-right: 40px; spacing: 24px;
            Hint { badge: @tr("A"); label: @tr("Select"); }
            Hint { badge: @tr("B"); label: root.quit-hint ? @tr("Quit") : @tr("Back"); }
            if root.favorite-hint && !root.sheet-open: Hint { badge: @tr("X"); label: root.favorite-label; }
            if root.detail-hint && !root.sheet-open: Hint { badge: @tr("X"); label: @tr("Details"); }
            if root.local-add-hint && !root.sheet-open: Hint { badge: @tr("Y"); label: LocalStrings.add-hint; }
            if root.local-remove-hint && !root.sheet-open: Hint { badge: @tr("X"); label: LocalStrings.remove; }
            if root.import-hint && !root.sheet-open: Hint { badge: @tr("Y"); label: @tr("Import"); }
            if root.profile-hint: Hint { badge: @tr("L1/R1"); label: @tr("Profile"); pill: true; }
            if root.root-screen && !root.sheet-open: Hint { badge: @tr("L1/R1"); label: @tr("Tabs"); pill: true; }
            if root.category-hint && !root.sheet-open: Hint { badge: @tr("L2/R2"); label: @tr("Category"); pill: true; }
            if !root.sheet-open || root.local-confirm-hint: Hint { badge: @tr("Start"); label: root.local-confirm-hint ? LocalStrings.confirm : LocalStrings.menu; pill: true; }
        }
    }
    if root.input-locked: Text {x:40px;y:parent.height - 64px;height:64px;text:@tr("Game running — return here when you exit");color:Tokens.muted;vertical-alignment:center;}
    // Isolated off-screen fixture verifies glyph bounds without desktop capture.
    if root.fit-test-visible: Rectangle {
        width: parent.width; height: parent.height; background: Tokens.canvas;
        FittedText {
            x: 40px; y: 240px; width: root.fit-width * 1px; height: root.fit-height * 1px;
            label: root.fit-label; base-size: root.fit-size * 1px;
            smaller-size: root.fit-smaller * 1px; display: root.fit-display; strong: root.fit-strong;
            multiline: root.fit-multiline; full: root.fit-full;
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.action(0); return accept; }
            if event.text == Key.DownArrow { root.action(1); return accept; }
            if event.text == Key.LeftArrow { root.action(2); return accept; }
            if event.text == Key.RightArrow { root.action(3); return accept; }
            if event.text == Key.Return { root.action(4); return accept; }
            if event.text == Key.Escape { root.action(5); return accept; }
            if event.text == "x" { root.action(6); return accept; }
            if event.text == "y" { root.action(7); return accept; }
            if event.text == Key.Tab { root.action(event.modifiers.shift ? 8 : 9); return accept; }
            if event.text == "[" { root.action(11); return accept; }
            if event.text == "]" { root.action(12); return accept; }
            if event.text == Key.F1 { root.action(20); return accept; }
            if event.text == Key.F2 { root.action(21); return accept; }
            if event.text == Key.F3 { root.action(22); return accept; }
            if event.text == Key.F4 { root.action(23); return accept; }
            if event.text == Key.Menu { root.action(10); return accept; }
            return reject;
        }
    }
}
