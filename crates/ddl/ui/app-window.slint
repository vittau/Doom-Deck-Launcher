        label: root.item.label; base-size: root.item.size * 1px; smaller-size: Tokens.metadata;
        display: false; multiline: false; centered: true;
        ink: root.item.primary ? Tokens.on-accent : Tokens.text;
    }
    if item.kind == 16: Image {
        x: 16px; y: 22px; width: 24px; height: 24px;
        source: @image-url("assets/ember/lock.svg");
    }
    if item.kind == 16: FittedText {
        x: 56px; y: 8px; width: parent.width - 72px; height: 30px;
        label: root.item.label; base-size: root.item.size * 1px; smaller-size: Tokens.metadata;
        display: false; multiline: false; ink: Tokens.muted;
    }
    if item.fitted-label && item.kind == 3: FittedText {
        x: 16px; y: 8px; width: parent.width - 32px; height: 30px;
        label: root.item.label; base-size: root.item.size * 1px; smaller-size: Tokens.metadata;
        display: false; strong: true; multiline: false;
    }
    if item.kind >= 20 && item.kind <= 23: FittedText {
