    in property <string> sheet-title;
    in property <float> sheet-height: 300;
    in property <bool> profile-hint: false;
    in property <bool> profile-name-open: false;
    in-out property <string> profile-name;
    in-out property <string> profile-name-error;
    callback profile-name-focused();
    changed profile-name-open => {
        if profile-name-open { name-input.focus(); name-input.select-all(); } else { keys.focus(); }
    }
    changed focused => {
