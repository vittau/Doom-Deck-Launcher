    }
    if !item.fitted-label && item.kind < 20 && item.kind != 1 && item.kind != 4 && item.kind != 6 && item.kind != 8 && item.kind != 10 && item.kind != 11 && item.kind != 12 && item.kind != 13 && item.kind != 14 && item.kind != 15 && item.kind != 16: Text {
        x: item.kind == 7 ? 32px : item.kind == 8 ? 8px : item.kind == 0 ? 0px : 16px;
