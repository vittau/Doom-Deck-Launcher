import "assets/InterVariable.ttf";
import "assets/Barlow-Regular.ttf";
import "assets/PirataOne-Regular.ttf";
import { ScreenshotAssets } from "@screenshots";
export { ScreenshotAssets } from "@screenshots";
import { WiringStrings } from "wiring-strings.slint";
import { LocalStrings } from "local-strings.slint";
export { LocalStrings } from "local-strings.slint";
import { Tokens } from "tokens.slint";
import { VectorFrame } from "assets/ember/frame.slint";
export { WiringStrings } from "wiring-strings.slint";
export { Strings } from "strings.slint";
// One bounded plane for pointer and controller scrolling. Offsets are logical pixels.
// `offset` is the single source of truth for the vertical position: `scroll()` never
// reads `content-y`, which lags `offset` until the change handler runs (a stale read
// on the 60 Hz stick poll used to overwrite the focus-follow offset, spec 061).
component ScrollPlane inherits Flickable {
    in-out property <float> offset: 0;
    in property <float> extent-height;
    in property <float> extent-width;
    // Focus-follow can align the final item at the top. Reserve its trailing
    // viewport space so Flickable does not clamp that landing back to a partial
    // previous row. Manual scrolling remains bounded by the current extent.
    content-height: max(max(self.height, extent-height * 1px), self.height + offset * 1px);
    content-width: max(self.width, extent-width * 1px);
    content-y: -offset * 1px;
    changed content-y => { offset = -self.content-y / 1px; }
    changed offset => { self.content-y = -self.offset * 1px; }
    public function scroll(dx: float, dy: float) {
        self.content-x = clamp(self.content-x - dx * 1px, min(0px, self.width - self.content-width), 0px);
        // A neutral tick also preserves a focus-aligned final row when its top
        // lies past the normal manual-scroll limit (the remainder still fits).
        if dy != 0 {
            self.offset = clamp(self.offset + dy, 0, max(0, (self.content-height - self.height) / 1px));
        }
    }
}
export struct ViewNode {
    id: int, x: float, y: float, w: float, h: float,
    kind: int, label: string, detail: string, tone: int, size: float, art: int,
    primary: bool, actionable: bool, fitted-label: bool, screenshot: string,
}
// Preserve the opaque centre of the former nine-slice, including on sheets.
component Frame inherits VectorFrame { background: Tokens.surface; }

component Cover inherits Image {
    in property <int> art;
    in property <string> screenshot;
    source: screenshot != "" ? ScreenshotAssets.image(screenshot) : art == 1 ? @image-url("assets/ember/sigil-ii.jpg") : art == 2 ? @image-url("assets/ember/auger.jpg") : art == 3 ? @image-url("assets/ember/eviternity.jpg") : art == 0 ? @image-url("assets/ember/sigil.jpg") : @image-url("assets/ember/fallback.jpg");
    image-fit: cover;
    horizontal-alignment: center;
    vertical-alignment: center;
}
// Measurements use the same bundled face and width as the rendered text.
component FittedText inherits Rectangle {
    // Leave room for Pirata One's negative side bearings (e.g. the initial A).
    clip: true;
    in property <string> label;
    in property <length> base-size;
    in property <length> smaller-size;
    in property <bool> display: true;
    in property <bool> strong: false;
    in property <bool> centered: false;
    in property <bool> multiline: true;
    in property <bool> full: false;
    in property <bool> title-slot: true;
    in property <color> ink: Tokens.text;
    out property <length> line-height: line.preferred-height;
    out property <length> content-height: title-slot ? min(self.height, line-height * (multiline ? 2 : 1)) : self.height;
    out property <length> base-width: base.preferred-width;
    out property <length> base-height: base.preferred-height;
    out property <length> measured-height: measure.preferred-height;
    out property <length> measured-width: measure.preferred-width;
    out property <length> fitted-size: base.preferred-height <= self.height && (multiline || base.preferred-width <= self.width) ? base-size : smaller-size;
    base := Text {
        visible: false; width: max(0px, parent.width - 8px); text: root.label;
        font-family: root.display ? "Pirata One" : "Barlow";
        font-size: root.base-size; font-weight: root.display || root.strong ? 600 : 400;
        wrap: root.multiline ? word-wrap : no-wrap;
    }
    measure := Text {
        visible: false; width: max(0px, parent.width - 8px); text: root.label;
        font-family: root.display ? "Pirata One" : "Barlow";
        font-size: root.fitted-size; font-weight: root.display || root.strong ? 600 : 400;
        wrap: root.multiline ? word-wrap : no-wrap;
    }
    line := Text {
        // A bundled family name is a fixed, non-copy, single-line metric sample.
        visible: false; text: self.font-family;
        font-family: root.display ? "Pirata One" : "Barlow";
        font-size: root.fitted-size; font-weight: root.display || root.strong ? 600 : 400;
    }
    Text {
        x: 4px; y: root.centered ? (parent.height - root.content-height) / 2 : 0px;
        width: max(0px, parent.width - 8px); height: root.content-height; text: root.label;
        font-family: root.display ? "Pirata One" : "Barlow";
        font-size: root.fitted-size; font-weight: root.display || root.strong ? 600 : 400;
        wrap: root.multiline ? word-wrap : no-wrap;
        overflow: root.full ? clip : elide; color: root.ink;
    }
}
component Node inherits Rectangle {
    in property <ViewNode> item;
    in property <bool> focused;
    in property <bool> install-primary: false;
