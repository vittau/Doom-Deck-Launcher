    in property <bool> art-band;
    in property <int> band-art;
    in property <string> band-screenshot;
    in property <string> heading;
    // A state, requirement or next step; empty for most screens, so the title stands alone.
    in property <string> status;
    in property <string> a-hint: @tr("Open");
    in property <bool> favorite-hint: false;
    in property <string> favorite-label: @tr("Favorite");
    in property <bool> category-hint: false;
    in property <bool> import-hint: false;
    in property <bool> local-add-hint: false;
    in property <bool> local-remove-hint: false;
    in property <bool> local-confirm-hint: false;
    in property <bool> detail-hint: false;
    in property <bool> quit-hint: false;
    in-out property <string> toast;
    property <string> displayed-toast;
    out property <float> toast-opacity: toast-banner.opacity;
    callback show-toast(string);
    show-toast(message) => {
        root.toast = message;
        root.displayed-toast = message;
        if message != "" { toast-timer.running = true; toast-timer.restart(); } else { toast-timer.stop(); }
    }
    toast-timer := Timer { interval: 3000ms; running: false; triggered => { root.toast = ""; self.stop(); } }
    in property <bool> install-pulse: false;
    in property <bool> discover-screen: false;
    out property <bool> tabs-enabled: root-screen && !sheet-open && !input-locked;
    in-out property <float> scroll-offset: 0;
    in property <float> content-height: 518;
    in property <float> content-width: 1240;
    in property <float> setup-content-height: 518;
    in property <float> setup-content-width: 540;
    in property <bool> setup-right-focused;
    in-out property <float> setup-scroll-offset: 0;
    in-out property <float> sheet-scroll-offset: 0;
    in property <string> sheet-error-text;
    out property <float> scroll-x-offset: -main-plane.content-x / 1px;
    out property <float> error-scroll-offset: error-plane.offset;
    callback reset-scroll-x();
    reset-scroll-x => { main-plane.content-x = 0px; setup-plane.content-x = 0px; }
    callback scroll(float, float);
    scroll(dx, dy) => {
        if !root.input-locked {
