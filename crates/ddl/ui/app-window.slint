component Badge inherits Rectangle {
    in property <string> label;
    in property <bool> pill: false;
    width: pill ? 54px : 28px; height: 28px;
    background: Tokens.raised; border-width: 1px; border-color: Tokens.muted;
    border-radius: pill ? 7px : 14px;
    Text { text: root.label; color: Tokens.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}
// Explicit intrinsic width keeps the compact footer stable across conditional hints.
component Hint inherits Rectangle {
    in property <string> badge;
    in property <string> label;
    in property <bool> pill: false;
    horizontal-stretch: 0;
    width: (pill ? 54px : 28px) + 8px + caption.preferred-width;
    height: 28px;
    Badge { x: 0px; y: 0px; label: root.badge; pill: root.pill; }
    caption := Text {
        x: root.pill ? 62px : 36px; width: parent.width - self.x; height: parent.height;
        text: root.label; color: Tokens.muted; font-size: Tokens.metadata; vertical-alignment: center;
    }
}
export component AppWindow inherits Window {
