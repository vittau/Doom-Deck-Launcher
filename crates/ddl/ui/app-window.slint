    out property <float> fit-content-height: probe.content-height / 1px;
    out property <float> fit-base-width: probe.base-width / 1px;
    out property <float> fit-base-height: probe.base-height / 1px;
    out property <float> fit-measured-height: probe.measured-height / 1px;
    out property <float> fit-measured-width: probe.measured-width / 1px;
    out property <float> fit-chosen-size: probe.fitted-size / 1px;
    probe := FittedText {
        visible: false; label: root.fit-label; width: root.fit-width * 1px;
        height: root.fit-height * 1px; base-size: root.fit-size * 1px;
