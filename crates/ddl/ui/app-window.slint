        image-fit: contain;
    }
    if item.kind == 12: Rectangle {
        background: Tokens.deep; border-radius: parent.width / 2; border-width: 2px; border-color: Tokens.line;
        Image { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; width: 24px; height: 24px; source: @image-url("assets/ember/favorite.svg"); }
    }
    if item.kind == 14: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        background: transparent; border-width: 1px; border-color: root.item.primary ? Tokens.text : Tokens.line; border-radius: Tokens.row-radius;
        Text { x: 6px; width: parent.width - 12px; text: root.item.label; color: root.item.primary ? Tokens.on-accent : Tokens.text; font-size: root.item.size * 1px; font-weight: root.item.primary ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    if item.kind == 13: Rectangle {
        y: 0px; height: parent.height; width: parent.width;
        background: Tokens.raised; border-radius: parent.height / 2; border-width: 1px; border-color: Tokens.line;
        Text { x: 10px; width: parent.width - 20px; text: root.item.label; color: Tokens.text; font-size: root.item.size * 1px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    if item.kind == 15: Rectangle {
        Rectangle {
            x: 16px; y: (parent.height - 28px) / 2; width: 28px; height: 28px;
            background: Tokens.deep; border-width: 2px; border-radius: 6px;
            border-color: root.item.art == 1 ? Tokens.focus : Tokens.line;
