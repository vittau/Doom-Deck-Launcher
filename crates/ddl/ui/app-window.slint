    x: item.x * 1px; y: item.y * 1px;
    width: item.w * 1px; height: item.h * 1px;
    background: item.kind == 16 ? Tokens.deep : item.kind == 1 || item.kind == 4 ? Tokens.surface : item.kind == 2 || item.kind == 3 || item.kind == 8 || item.kind == 9 || item.kind == 14 ? (item.primary ? root.primary-ink : Tokens.raised) : transparent;
    border-radius: item.kind == 1 || item.kind == 4 ? Tokens.card-radius : Tokens.row-radius;
    border-width: item.kind == 1 ? 1px : 0px;
    border-color: Tokens.steel-edge;
    if focused: Rectangle {
        x: root.item.kind == 1 ? -16px : -8px; y: root.item.kind == 1 ? -16px : -8px;
        width: parent.width + (root.item.kind == 1 ? 32px : 16px); height: parent.height + (root.item.kind == 1 ? 32px : 16px);
        background: Tokens.deep; border-radius: 16px; border-color: Tokens.focus; border-width: 4px;
        if root.item.kind != 1: Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; background: root.item.primary ? root.primary-ink : Tokens.raised; border-radius: Tokens.row-radius; }
    }
    if item.kind == 1: Frame { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px; }
    if item.kind == 2 || item.kind == 3 || item.kind == 8 || item.kind == 16: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
