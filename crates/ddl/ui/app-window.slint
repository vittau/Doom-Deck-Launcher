    default-font-family: "Barlow"; default-font-size: Tokens.body;
    background: Tokens.canvas;
    in property <[ViewNode]> nodes;
    in property <int> focused: 0;
    in property <int> active-tab: 0;
    in property <bool> root-screen: true;
