        display: root.fit-display; strong: root.fit-strong;
    }
    callback quit-requested();
    callback services-ready();
    in property <bool> setup-screen: false;
    callback action(int);
    callback clicked(int);
    out property <bool> input-active: keys.has-focus;
    forward-focus: keys;
    // Pointer motion never changes the logical target; clicks use the same action path.
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; mouse-cursor: none; }
    Image { x: 0px; y: 104px; width: parent.width; height: parent.height - 168px; source: @image-url("assets/ember/wall.jpg"); image-fit: fill; }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 104px; background: Tokens.deep;
        Image { x: 40px; y: 24px; width: 154px; height: 56px; source: @image-url("assets/logo/horizontal.svg"); image-fit: contain; }
        for label[index] in [@tr("Home"), @tr("Library"), @tr("Discover"), @tr("Settings")]: Rectangle {
            x: (214 + index * 180) * 1px; y: 24px; width: 148px; height: 52px;
            background: root.tabs-enabled && root.active-tab == index ? Tokens.raised : transparent; border-radius: 8px;
            if root.focused == -index - 1 && root.tabs-enabled: Rectangle { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px; border-width: 4px; border-color: Tokens.focus; border-radius: 16px; background: transparent; }
            Text { text: label; color: root.tabs-enabled ? Tokens.text : Tokens.disabled; horizontal-alignment: center; vertical-alignment: center; }
            if root.tabs-enabled && root.active-tab == index: Rectangle { y: 56px; x: 24px; width: 100px; height: 3px; background: Tokens.focus; }
            TouchArea { mouse-cursor: none; clicked => { if root.root-screen && !root.sheet-open { root.action(20 + index); } } }
        }
        Rectangle { x: 40px; y: 102px; width: parent.width - 80px; height: 1px; background: Tokens.steel-edge; }
    }
    Rectangle { x: 40px; y: 120px; width: root.art-band ? 800px : parent.width - 80px; height: 88px; background: Tokens.deep; }
    if root.art-band: Rectangle {
        x: parent.width - 440px; y: 120px; width: 400px; height: 88px;
        clip: true;
        Image { width: parent.width; height: parent.height; source: root.band-screenshot != "" ? ScreenshotAssets.image(root.band-screenshot) : root.band-art == 1 ? @image-url("assets/ember/sigil-ii-band.jpg") : root.band-art == 2 ? @image-url("assets/ember/auger-band.jpg") : root.band-art == 3 ? @image-url("assets/ember/eviternity-band.jpg") : root.band-art == 0 ? @image-url("assets/ember/sigil-band.jpg") : @image-url("assets/ember/fallback-band.jpg"); image-fit: cover; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { x: 0px; y: 0px; width: 120px; height: parent.height; background: @linear-gradient(90deg, Tokens.deep 0%, Tokens.deep.with-alpha(0) 100%); }
    }
