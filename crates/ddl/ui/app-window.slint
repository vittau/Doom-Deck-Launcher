        display: root.item.kind != 21 && root.item.kind != 23;
        multiline: root.item.kind != 21 && root.item.h >= 60;
        full: root.item.kind == 22;
        title-slot: root.item.kind != 23;
        ink: root.item.kind == 21 ? Tokens.muted : Tokens.text;
    }
    if item.detail != "": Text {
        x: item.kind == 16 ? 56px : 16px; y: 38px; width: parent.width - (item.kind == 16 ? 72px : 32px); height: parent.height - 42px;
        text: item.detail; color: Tokens.muted; font-size: Tokens.metadata; wrap: word-wrap;
    }
