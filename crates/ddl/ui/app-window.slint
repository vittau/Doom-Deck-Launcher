        }
        Text { x: 56px; y: 0px; width: parent.width - 72px; height: parent.height; text: root.item.label; color: Tokens.text; font-size: root.item.size * 1px; vertical-alignment: center; wrap: word-wrap; }
    }
    if item.kind == 7: Image {
        x: 0px; y: 2px; width: 24px; height: 24px;
