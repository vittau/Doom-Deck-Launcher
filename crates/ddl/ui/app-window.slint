import "assets/InterVariable.ttf";
import "assets/Barlow-Regular.ttf";
import "assets/PirataOne-Regular.ttf";
import { ScreenshotAssets } from "@screenshots";
export { ScreenshotAssets } from "@screenshots";
import { WiringStrings } from "wiring-strings.slint";
import { Tokens } from "tokens.slint";
export { WiringStrings } from "wiring-strings.slint";
export { Strings } from "strings.slint";
export struct ViewNode {
    id: int, x: float, y: float, w: float, h: float,
    kind: int, label: string, detail: string, tone: int, size: float, art: int,
    primary: bool, actionable: bool, screenshot: string, credit: string,
}
component Frame inherits Rectangle {
    background: transparent;
    Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: @image-url("assets/ember/frame.png", nine-slice(28)); image-fit: fill; }
    Image { x: (parent.width - 96px) / 2; y: 0px; width: 96px; height: 28px; source: @image-url("assets/ember/ornament-top.png"); }
    Image { x: (parent.width - 96px) / 2; y: parent.height - 28px; width: 96px; height: 28px; source: @image-url("assets/ember/ornament-bottom.png"); }
    Image { x: 0px; y: (parent.height - 48px) / 2; width: 28px; height: 48px; source: @image-url("assets/ember/ornament-left.png"); }
    Image { x: parent.width - 28px; y: (parent.height - 48px) / 2; width: 28px; height: 48px; source: @image-url("assets/ember/ornament-right.png"); }
}
component Cover inherits Image {
    in property <int> art;
    in property <string> screenshot;
    source: screenshot != "" ? ScreenshotAssets.image(screenshot) : art == 1 ? @image-url("assets/ember/sigil-ii.png") : art == 2 ? @image-url("assets/ember/auger.png") : art == 3 ? @image-url("assets/ember/eviternity.png") : art == 0 ? @image-url("assets/ember/sigil.png") : @image-url("assets/ember/fallback.png");
    image-fit: cover;
    horizontal-alignment: center;
    vertical-alignment: center;
}
component ArtCaption inherits Rectangle {
    in property <string> label;
    height: caption.preferred-height + 12px;
    background: Tokens.deep;
    border-width: 1px; border-color: Tokens.steel-edge; border-radius: 4px;
    caption := Text {
        x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
        text: root.label; wrap: word-wrap; color: Tokens.text; font-size: Tokens.metadata;
        vertical-alignment: center;
    }
}
component Node inherits Rectangle {
    in property <ViewNode> item;
    in property <bool> focused;
    callback activate(int);
    x: item.x * 1px; y: item.y * 1px;
    width: item.w * 1px; height: item.h * 1px;
    background: item.kind == 1 || item.kind == 4 ? Tokens.surface : item.kind == 2 || item.kind == 3 || item.kind == 8 || item.kind == 9 || item.kind == 14 ? (item.primary ? Tokens.focus : Tokens.raised) : transparent;
    border-radius: item.kind == 1 || item.kind == 4 ? Tokens.card-radius : Tokens.row-radius;
    border-width: item.kind == 1 ? 1px : 0px;
    border-color: Tokens.steel-edge;
    if focused: Rectangle {
        x: root.item.kind == 1 ? -16px : -8px; y: root.item.kind == 1 ? -16px : -8px;
        width: parent.width + (root.item.kind == 1 ? 32px : 16px); height: parent.height + (root.item.kind == 1 ? 32px : 16px);
        background: Tokens.deep; border-radius: 16px; border-color: Tokens.focus; border-width: 4px;
        if root.item.kind != 1: Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; background: root.item.primary ? Tokens.focus : Tokens.raised; border-radius: Tokens.row-radius; }
    }
    if item.kind == 1: Frame { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px; }
    if item.kind == 2 || item.kind == 3 || item.kind == 8: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        background: transparent; border-width: 1px; border-color: root.item.primary ? Tokens.text : Tokens.line; border-radius: Tokens.row-radius;
    }
    if item.kind == 6: Rectangle {
        y: (parent.height - 12px) / 2; height: 12px; width: parent.width;
        background: Tokens.raised; border-radius: 6px;
        Rectangle {height: parent.height; x: root.item.art < 0 ? parent.width / 3 : 0px; width: root.item.art < 0 ? parent.width / 3 : parent.width * root.item.art / 1000; background: Tokens.focus; border-radius: 6px;}
    }
    if item.kind == 4: Rectangle {
        clip: true; border-radius: Tokens.card-radius;
        Cover { x: 0px; y: 0px; width: parent.width; height: parent.height; art: root.item.art; screenshot: root.item.screenshot; }
        if root.item.h >= 80: ArtCaption {
            x: 8px; y: parent.height - self.height - 8px; width: parent.width - 16px;
            label: root.item.screenshot != "" ? root.item.credit : WiringStrings.concept-art;
        }
    }
    if item.kind == 16: ArtCaption {
        width: parent.width; height: parent.height; label: root.item.label;
    }

    if item.kind == 10 || item.kind == 11: Image {
        width: parent.width; height: parent.height;
        source: root.item.kind == 10 ? @image-url("assets/logo/full-name.svg") : @image-url("assets/logo/stacked.svg");
        image-fit: contain;
    }
    if item.kind == 12: Rectangle {
        background: Tokens.deep; border-radius: parent.width / 2; border-width: 2px; border-color: Tokens.line;
        Image { x: (parent.width - 24px) / 2; y: (parent.height - 24px) / 2; width: 24px; height: 24px; source: @image-url("assets/ember/favorite.svg"); }
    }
    if item.kind == 14: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        background: transparent; border-width: 1px; border-color: root.item.primary ? Tokens.text : Tokens.line; border-radius: Tokens.row-radius;
        Text { x: 6px; width: parent.width - 12px; text: root.item.label; color: root.item.primary ? Tokens.on-accent : Tokens.text; font-size: root.item.size * 1px; font-weight: root.item.primary ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    if item.kind == 13: Rectangle {
        y: 0px; height: parent.height; width: parent.width;
        background: Tokens.raised; border-radius: parent.height / 2; border-width: 1px; border-color: Tokens.line;
        Text { x: 10px; width: parent.width - 20px; text: root.item.label; color: Tokens.text; font-size: root.item.size * 1px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    if item.kind == 15: Rectangle {
        Rectangle {
            x: 16px; y: (parent.height - 28px) / 2; width: 28px; height: 28px;
            background: Tokens.deep; border-width: 2px; border-radius: 6px;
            border-color: root.item.art == 1 ? Tokens.focus : Tokens.line;
            if root.item.art == 1: Image { x: 2px; y: 2px; width: 24px; height: 24px; source: @image-url("assets/ember/check.svg"); }
        }
        Text { x: 56px; y: 0px; width: parent.width - 72px; height: parent.height; text: root.item.label; color: Tokens.text; font-size: root.item.size * 1px; vertical-alignment: center; wrap: word-wrap; }
    }
    if item.kind == 7: Image {
        x: 0px; y: 2px; width: 24px; height: 24px;
        source: root.item.tone == 2 ? @image-url("assets/ember/check.svg") : root.item.tone == 4 ? @image-url("assets/ember/cross.svg") : @image-url("assets/ember/pending.svg");
    }
    if item.kind != 1 && item.kind != 4 && item.kind != 6 && item.kind != 10 && item.kind != 11 && item.kind != 12 && item.kind != 13 && item.kind != 14 && item.kind != 15 && item.kind != 16: Text {
        x: item.kind == 7 ? 32px : item.kind == 8 ? 8px : item.kind == 0 ? 0px : 16px;
        y: item.kind == 7 || item.kind == 0 ? 0px : item.kind == 9 ? 4px : 8px;
        width: parent.width - (item.kind == 0 ? 0px : item.kind == 8 ? 16px : 32px);
        height: item.kind == 9 ? 24px : item.detail == "" ? parent.height - (item.kind == 0 ? 0px : 16px) : 30px;
        text: item.label;
        color: item.kind == 7 ? (item.tone == 3 ? Tokens.muted : Tokens.text) : item.primary ? Tokens.on-accent : item.tone == 1 ? Tokens.muted : item.tone == 2 ? Tokens.success : item.tone == 3 ? Tokens.warning : item.tone == 4 ? Tokens.danger : Tokens.text;
        font-family: item.kind == 0 && item.size >= 26 ? "Pirata One" : "Barlow";
        font-size: item.size * 1px; font-weight: item.kind == 2 || item.kind == 3 || item.size >= 26 ? 600 : 400;
        wrap: word-wrap; vertical-alignment: item.kind == 0 || item.kind == 7 || item.kind == 9 ? top : center;
    }
    if item.detail != "": Text {
        x: 16px; y: 38px; width: parent.width - 32px; height: parent.height - 42px;
        text: item.detail; color: Tokens.muted; font-size: Tokens.metadata; wrap: word-wrap;
    }
    if item.actionable: TouchArea {
        mouse-cursor: none;
        clicked => { root.activate(root.item.id); }
    }
}
component Badge inherits Rectangle {
    in property <string> label;
    in property <bool> pill: false;
    width: pill ? 54px : 28px; height: 28px;
    background: Tokens.raised; border-width: 1px; border-color: Tokens.muted;
    border-radius: pill ? 7px : 14px;
    Text { text: root.label; color: Tokens.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}
component Hint inherits HorizontalLayout {
    in property <string> badge;
    in property <string> label;
    in property <bool> pill: false;
    spacing: 8px; alignment: start; horizontal-stretch: 0;
    height: 28px;
    Badge { label: root.badge; pill: root.pill; }
    Text { text: root.label; color: Tokens.muted; font-size: Tokens.metadata; vertical-alignment: center; }
}
export component AppWindow inherits Window {
    title: @tr("DoomDeckLauncher");
    out property <image> app-icon: @image-url("assets/logo/icon.png");
    icon: app-icon;
    width: 1280px; height: 800px;
    default-font-family: "Barlow"; default-font-size: Tokens.body;
    background: Tokens.canvas;
    in property <[ViewNode]> nodes;
    in property <int> focused: 0;
    in property <int> active-tab: 0;
    in property <bool> root-screen: true;
    in property <bool> input-locked: false;
    in property <bool> art-band;
    in property <int> band-art;
    in property <string> band-screenshot;
    in property <string> band-credit;
    in property <string> heading;
    in property <string> subtitle;
    in property <string> a-hint: @tr("Open");
    in property <bool> favorite-hint: false;
    in property <string> favorite-label: @tr("Favorite");
    in property <bool> category-hint: false;
    in property <bool> import-hint: false;
    in property <bool> detail-hint: false;
    in property <string> toast;
    in property <float> scroll-offset: 0;
    in property <[ViewNode]> sheet-nodes;
    in property <bool> sheet-open: false;
    in property <string> sheet-title;
    in property <float> sheet-height: 300;
    callback quit-requested();
    callback services-ready();
    in property <bool> setup-screen: false;
    callback action(int);
    callback clicked(int);
    out property <bool> input-active: keys.has-focus;
    forward-focus: keys;
    // Pointer motion never changes the logical target; clicks use the same action path.
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; mouse-cursor: none; }
    Image { x: 0px; y: 104px; width: parent.width; height: parent.height - 168px; source: @image-url("assets/ember/wall.png"); image-fit: fill; }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 104px; background: Tokens.deep;
        Image { x: 40px; y: 24px; width: 154px; height: 56px; source: @image-url("assets/logo/horizontal.svg"); image-fit: contain; }
        for label[index] in [@tr("Home"), @tr("Discover"), @tr("Library"), @tr("Settings")]: Rectangle {
            x: (214 + index * 180) * 1px; y: 24px; width: 148px; height: 52px;
            background: root.active-tab == index ? Tokens.raised : transparent; border-radius: 8px;
            if root.focused == -index - 1 && !root.sheet-open: Rectangle { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px; border-width: 4px; border-color: Tokens.focus; border-radius: 16px; background: transparent; }
            Text { text: label; color: Tokens.text; horizontal-alignment: center; vertical-alignment: center; }
            if root.active-tab == index: Rectangle { y: 56px; x: 24px; width: 100px; height: 3px; background: Tokens.focus; }
            TouchArea { mouse-cursor: none; clicked => { if root.root-screen && !root.sheet-open { root.action(20 + index); } } }
        }
        Text { x: parent.width - 260px; y: 36px; text: @tr("DoomDeckLauncher"); color: Tokens.muted; font-size: Tokens.metadata; }
        Rectangle { x: 40px; y: 102px; width: parent.width - 80px; height: 1px; background: Tokens.steel-edge; }
    }
    Rectangle { x: 40px; y: 120px; width: root.art-band ? 800px : parent.width - 80px; height: 88px; background: Tokens.deep; }
    if root.art-band: Rectangle {
        x: parent.width - 440px; y: 120px; width: 400px; height: 88px;
        clip: true;
        Image { width: parent.width; height: parent.height; source: root.band-screenshot != "" ? ScreenshotAssets.image(root.band-screenshot) : root.band-art == 1 ? @image-url("assets/ember/sigil-ii-band.png") : root.band-art == 2 ? @image-url("assets/ember/auger-band.png") : root.band-art == 3 ? @image-url("assets/ember/eviternity-band.png") : root.band-art == 0 ? @image-url("assets/ember/sigil-band.png") : @image-url("assets/ember/fallback-band.png"); image-fit: cover; horizontal-alignment: center; vertical-alignment: center; }
        ArtCaption { x: 8px; y: parent.height - self.height - 8px; width: parent.width - 16px;
            label: root.band-screenshot != "" ? root.band-credit : WiringStrings.concept-art;
        }
    }
    Text { x: 40px; y: 124px; width: root.art-band ? 784px : parent.width - 80px; height: 48px; text: root.heading; font-family: "Pirata One"; font-size: Tokens.page; color: Tokens.text; }
    Text { x: 40px; y: 176px; width: root.art-band ? 784px : parent.width - 80px; height: 32px; text: root.subtitle; color: Tokens.muted; overflow: elide; }
    Flickable {
        x: 20px; y: 210px; width: parent.width - 40px; height: parent.height - 278px;
        content-width: 1240px; content-height: 518px + root.scroll-offset * 1px;
        content-y: -root.scroll-offset * 1px;
        for item in root.nodes: Node { x: (item.x + 8) * 1px; y: (item.y + 8) * 1px; visible: !root.setup-screen || item.x < 700; item: item; focused: root.focused == item.id && !root.sheet-open; activate(id) => { root.clicked(id); } }
    }
    if root.setup-screen: Rectangle {
        x: 28px; y: 218px; width: parent.width - 56px; height: parent.height - 294px;
        for item in root.nodes: Node { visible: item.x >= 700; item: item; focused: root.focused == item.id && !root.sheet-open; activate(id) => { root.clicked(id); } }
    }
    if root.toast != "": Rectangle {
        x: 40px; y: 172px; width: parent.width - 80px; height: 64px;
        background: Tokens.raised; border-radius: 8px; border-width: 2px; border-color: Tokens.line;
        Text { x: 16px; width: parent.width - 32px; text: root.toast; color: Tokens.text; font-size: Tokens.metadata; vertical-alignment: center; wrap: word-wrap; }
    }
    Rectangle {
        x: 0px; width: parent.width; y: parent.height - 64px; height: 64px; background: Tokens.deep;
        if !root.input-locked: HorizontalLayout {
            y: 18px; height: 28px; alignment: start;
            padding-left: 40px; padding-right: 40px; spacing: 24px;
            Hint { badge: @tr("A"); label: root.a-hint; }
            Hint { badge: @tr("B"); label: @tr("Back"); }
            if root.favorite-hint: Hint { badge: @tr("X"); label: root.favorite-label; }
            if root.detail-hint: Hint { badge: @tr("X"); label: @tr("Details"); }
            if root.import-hint: Hint { badge: @tr("Y"); label: @tr("Import"); }
            if root.root-screen && !root.sheet-open: Hint { badge: @tr("L1/R1"); label: @tr("Tabs"); pill: true; }
            if root.category-hint && !root.sheet-open: Hint { badge: @tr("L2/R2"); label: @tr("Category"); pill: true; }
            Hint { badge: @tr("Start"); label: @tr("Menu"); pill: true; }
        }
    }
    if root.input-locked: Text {x:40px;y:parent.height - 64px;height:64px;text:@tr("Game running — return here when you exit");color:Tokens.muted;vertical-alignment:center;}
    if root.sheet-open: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; background: #120C0DE0;
        Rectangle {
            x: (parent.width - 720px) / 2; y: (parent.height - root.sheet-height * 1px) / 2; width: 720px; height: root.sheet-height * 1px;
            background: Tokens.raised; border-width: 1px; border-color: Tokens.line; border-radius: 12px;
            Frame { width: parent.width; height: parent.height; }
            Text { x: 32px; y: 32px; width: parent.width - 64px; height: root.sheet-height > 400 ? 64px : root.sheet-height > 300 ? 164px : 96px; text: root.sheet-title; font-family: "Pirata One"; color: Tokens.text; font-size: Tokens.section; wrap: word-wrap; }
            for item in root.sheet-nodes: Node { item: item; focused: root.focused == item.id; activate(id) => { root.clicked(id); } }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.action(0); return accept; }
            if event.text == Key.DownArrow { root.action(1); return accept; }
            if event.text == Key.LeftArrow { root.action(2); return accept; }
            if event.text == Key.RightArrow { root.action(3); return accept; }
            if event.text == Key.Return { root.action(4); return accept; }
            if event.text == Key.Escape { root.action(5); return accept; }
            if event.text == "x" { root.action(6); return accept; }
            if event.text == "y" { root.action(7); return accept; }
            if event.text == Key.Tab { root.action(event.modifiers.shift ? 8 : 9); return accept; }
            if event.text == "[" { root.action(11); return accept; }
            if event.text == "]" { root.action(12); return accept; }
            if event.text == Key.F1 { root.action(20); return accept; }
            if event.text == Key.F2 { root.action(21); return accept; }
            if event.text == Key.F3 { root.action(22); return accept; }
            if event.text == Key.F4 { root.action(23); return accept; }
            if event.text == Key.Menu { root.action(10); return accept; }
            return reject;
        }
    }
}
