// Ember Cathedral (D-021); opaque body surfaces, original pre-rendered materials.
export global Tokens {
    out property <color> canvas: #120C0D;
    out property <color> surface: #211719;
    out property <color> raised: #352527;
    out property <color> text: #F8EAD5;
    out property <color> muted: #D0BCA7;
    out property <color> focus: #FFD078;
    out property <color> on-accent: #120C0D;
    out property <color> success: #88D9B0;
    out property <color> warning: #FFD078;
    out property <color> danger: #FFA69C;
    out property <color> line: #80533B;
    // Action red keeps >=4.5:1 against the dark on-accent label across the pulse.
    out property <color> ember-action: #BE6248;
    out property <color> ember-pulse: #CA6A50;
    out property <color> disabled: #817C7B;
    out property <color> ember: #B8583F;
    out property <color> copper: #B8583F;
    out property <color> steel-edge: #80533B;
    out property <color> deep: #120C0D;
    out property <length> page: 36px;
    out property <length> hero: 44px;
    out property <length> section: 26px;
    out property <length> body: 22px;
    out property <length> metadata: 20px;
    out property <length> page-line: 44px;
    out property <length> hero-line: 52px;
    out property <length> section-line: 34px;
    out property <length> body-line: 30px;
    out property <length> metadata-line: 28px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> space-12: 48px;
    out property <length> inset: 40px;
    out property <length> row-radius: 8px;
    out property <length> card-radius: 12px;
    out property <int> canvas-layer: 0;
    out property <int> surface-layer: 1;
    out property <int> sheet-layer: 2;
}
