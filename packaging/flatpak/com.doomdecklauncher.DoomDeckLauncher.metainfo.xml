<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.doomdecklauncher.DoomDeckLauncher</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>DoomDeckLauncher</name>
  <summary>Controller-first DOOM mapset launcher</summary>

  <developer id="io.github.vittau">
    <name>The DoomDeckLauncher contributors</name>
  </developer>

  <description>
    <p>
      DoomDeckLauncher is a controller-first launcher for classic DOOM and curated
      community mapsets. It keeps the official DSDA-Doom engine, your IWADs and your
      mapset library together, and starts the game without a terminal.
    </p>
    <p>
      Browse the bundled catalog, install mapsets from reviewed sources with SHA-256
      checks, let DDL identify and arrange your IWADs, and keep per-mapset profiles for
      difficulty, load order and compatibility level. The interface is designed for a
      gamepad and can be added to Steam as a non-Steam shortcut.
    </p>
    <p>
      The DSDA-Doom engine is downloaded at runtime from its official upstream release
      and is never bundled or mirrored by this package. IWADs are never downloaded.
    </p>
  </description>

  <launchable type="desktop-id">com.doomdecklauncher.DoomDeckLauncher.desktop</launchable>
  <provides>
    <binary>ddl</binary>
  </provides>

  <categories>
    <category>Game</category>
  </categories>

  <keywords>
    <keyword>doom</keyword>
    <keyword>wad</keyword>
    <keyword>launcher</keyword>
    <keyword>mapset</keyword>
    <keyword>gamepad</keyword>
  </keywords>

